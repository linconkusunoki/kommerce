# PostgreSQL connection string
DATABASE_URL=postgres://kommerce:kommerce@localhost:5432/kommerce

# Required to create the initial admin account during seeding
ADMIN_INITIAL_PASSWORD=

# Required for the shopping chatbot
GEMINI_API_KEY=

# Optional: enables order confirmation emails
RESEND_API_KEY=

# Optional: enables Product Image uploads through S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
