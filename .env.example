# PostgreSQL connection string
DATABASE_URL=postgres://kommerce:kommerce@localhost:5432/kommerce

# Required to create the initial admin account during seeding
ADMIN_INITIAL_PASSWORD=

# Required for the shopping chatbot
GEMINI_API_KEY=

# Optional: enables order confirmation emails
RESEND_API_KEY=

# Optional: enables Product Image uploads through S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=

# End-to-end tests (bun run test:e2e). Not read by the app itself.
# `bun run test:e2e` targets local and `bun run test:e2e:prod` targets
# production; that is the only difference. The suite loads .env itself and reuses
# ADMIN_INITIAL_PASSWORD to sign in as admin, so nothing here is needed.
#
# Override a target by hand: E2E_BASE_URL=http://localhost:3000
# Use a different admin password: E2E_ADMIN_PASSWORD=
# Sign in as an existing customer twice: E2E_CUSTOMER_EMAIL= / E2E_CUSTOMER_PASSWORD=
