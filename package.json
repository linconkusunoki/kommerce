{
  "name": "kommerce",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.tsx",
    "validate-env": "bun run scripts/validate-env.ts",
    "build": "bun run format:check && bun run validate-env && bun build src/index.tsx --outdir dist --target bun",
    "test": "bun test src/tests",
    "mcp": "bun run src/mcp.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "hono": "^4.11.9"
  }
}
